{
	"name": "beep-ui",
	"version": "4.1.8",
	"type": "module",
	"private": true,
	"scripts": {
		"test:unit": "cross-env VITE_TEST=unit vite test:unit",
		"test:e2e": "cross-env VITE_TEST=e2e vite test:e2e --headless",
		"build:ci": "yarn build --report",
		"build:staging": "cross-env NODE_ENV=production vite build --mode staging",
		"dev:e2e": "cross-env VITE_TEST=e2e vite test:e2e --mode=development",
		"docker": "docker-compose exec dev yarn",
		"lint": "eslint --ext .js,.vue --ignore-pattern=.gitignore --fix src",
		"lint:oxlint": "oxlint --fix src",
		"lint:eslint": "eslint --ext .js,.vue --ignore-pattern=.gitignore --fix src --cache",
		"dev": "vite -d",
		"build": "vite build",
		"serve": "vite preview",
		"test": "run-s test:unit test:e2e",
		"test:ci": "run-s test:unit:ci test:e2e",
		"test:unit:ci": "yarn test:unit --coverage --ci",
		"test:unit:file": "yarn test:unit --bail --findRelatedTests",
		"test:unit:watch": "yarn test:unit --watch --notify --notifyMode change"
	},
	"dependencies": {
		"@juggle/resize-observer": "^3.4.0",
		"@komgrip/vue3-treeselect": "^1.0.11",
		"@vuepic/vue-datepicker": "^7.1.0",
		"axios": "^1.12.0",
		"axios-actions": "^4.0.2",
		"chart.js": "^4.5.1",
		"chartjs-adapter-moment": "^1.0.1",
		"chartjs-plugin-annotation": "^2.2.1",
		"chartjs-plugin-datalabels": "^2.2.0",
		"core-js": "^3.9.1",
		"element-plus": "^2.5.1",
		"kind-of": ">=6.0.3",
		"lodash": "^4.17.21",
		"luxon": "^1.28.1",
		"moment-timezone": "^0.6.1",
		"nprogress": "^0.2.0",
		"sortablejs": "^1.10.2",
		"vue": "^3.5.12",
		"vue-add-to-calendar": "^1.0.6",
		"vue-chartjs": "^5.3.3",
		"vue-ellipse-progress": "^2.1.1",
		"vue-google-autocomplete": "^1.1.1",
		"vue-i18n": "^9.6.5",
		"vue-ios-pwa-prompt": "^1.0.4",
		"vue-meta": "^2.3.3",
		"vue-router": "^4.2.5",
		"vue-virtual-scroller": "^2.0.0-beta.8",
		"vue3-country-region-select": "^1.0.0",
		"vue3-treeselect": "^0.1.10",
		"vuedraggable": "^4.1.0",
		"vuex": "4.0"
	},
	"devDependencies": {
		"@babel/core": "^7.22.20",
		"@babel/eslint-parser": "^7.22.15",
		"@juggle/resize-observer": "^3.4.0",
		"@vitejs/plugin-vue": "^6.0.5",
		"@vue/cli-plugin-babel": "^5.0.8",
		"@vue/cli-plugin-eslint": "^5.0.9",
		"@vue/cli-plugin-unit-jest": "^5.0.8",
		"@vue/cli-service": "^5.0.9",
		"@vue/compiler-sfc": "^3.3.4",
		"@vue/eslint-config-prettier": "6.0.x",
		"@vue/eslint-config-standard": "^8.0.1",
		"@vue/test-utils": "^2.4.1",
		"@web-types/vue": "^2.5.0-4",
		"@web-types/vuetify": "^2.0.15-1",
		"babel-core": "7.0.0-bridge.0",
		"babel-plugin-component": "^1.1.1",
		"cross-env": "^7.0.3",
		"eslint": "^8.57.1",
		"eslint-config-standard": "^17.1.0",
		"eslint-plugin-import": "^2.28.1",
		"eslint-plugin-node": "11.0.x",
		"eslint-plugin-prettier": "^3.2.0",
		"eslint-plugin-promise": "^6.0.0",
		"eslint-plugin-standard": "^4.1.0",
		"eslint-plugin-vue": "^9.33.0",
		"eslint-plugin-vuetify": "^2.0.5",
		"express": "^4.18.2",
		"faker": "^4.1.0",
		"imagemin-lint-staged": "^0.5.1",
		"lint-staged": "10.0.x",
		"markdownlint-cli": "^0.31.1",
		"minify-css-string": "^1.0.0",
		"nth-check": "^2.0.1",
		"prettier": "^1.19.1",
		"sass": "^1.32.8",
		"sass-loader": "8.0.x",
		"stylelint": "^13.13.1",
		"stylelint-config-css-modules": "2.2.x",
		"stylelint-config-prettier": "^9.0.5",
		"stylelint-config-recess-order": "2.0.x",
		"stylelint-config-standard": "20.0.x",
		"stylelint-scss": "3.14.x",
		"vite": "^6.4.2",
		"vite-plugin-commonjs": "^0.10.4",
		"vite-plugin-vue-devtools": "^8.1.1",
		"vite-plugin-vuetify": "^2.1.3",
		"vue-cli-plugin-element": "^1.0.1",
		"vue-cli-plugin-vuetify": "^2.2.2",
		"vuetify": "^3.8.0",
		"webpack": "^5.88.2"
	},
	"engines": {
		"node": ">=10.13.3",
		"yarn": ">=1.0.0"
	},
	"resolutions": {
		"@vue/cli-plugin-unit-jest/jest": "25.1.x",
		"@vue/cli-plugin-unit-jest/babel-jest": "25.1.x"
	}
}
