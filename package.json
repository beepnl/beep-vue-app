{
	"name": "beep-ui",
	"version": "4.1.8",
	"type": "module",
	"private": true,
	"scripts": {
		"test:unit": "cross-env VITE_TEST=unit vite test:unit",
		"test:e2e": "cross-env VITE_TEST=e2e vite test:e2e --headless",
		"build:ci": "yarn build --report",
		"build:staging": "cross-env NODE_ENV=production vite build --mode staging",
		"dev:e2e": "cross-env VITE_TEST=e2e vite test:e2e --mode=development",
		"docker": "docker-compose exec dev yarn",
		"lint": "eslint --ext .js,.vue --ignore-pattern=.gitignore --fix src",
		"lint:oxlint": "oxlint --fix src",
		"lint:eslint": "eslint --ext .js,.vue --ignore-pattern=.gitignore --fix src --cache",
		"dev": "vite -d",
		"build": "vite build",
		"serve": "vite preview",
		"test": "run-s test:unit test:e2e",
		"test:ci": "run-s test:unit:ci test:e2e",
		"test:unit:ci": "yarn test:unit --coverage --ci",
		"test:unit:file": "yarn test:unit --bail --findRelatedTests",
		"test:unit:watch": "yarn test:unit --watch --notify --notifyMode change"
	},
	"dependencies": {
		"@juggle/resize-observer": "^3.4.0",
		"@komgrip/vue3-treeselect": "^1.0.11",
		"@vuepic/vue-datepicker": "^7.1.0",
		"axios": "^1.12.0",
		"axios-actions": "^4.0.2",
		"caniuse-lite": "^1.0.30001793",
		"chart.js": "^4.5.1",
		"chartjs-adapter-moment": "^1.0.1",
		"chartjs-plugin-annotation": "^2.2.1",
		"chartjs-plugin-datalabels": "^2.2.0",
		"core-js": "^3.9.1",
		"element-plus": "^2.5.1",
		"eslint-config-prettier": "^10.1.8",
		"kind-of": ">=6.0.3",
		"lodash": "^4.17.21",
		"luxon": "^1.28.1",
		"moment-timezone": "^0.6.1",
		"nprogress": "^0.2.0",
		"sortablejs": "^1.10.2",
		"vue": "^3.5.12",
		"vue-add-to-calendar": "^1.0.6",
		"vue-chartjs": "^5.3.3",
		"vue-ellipse-progress": "^2.1.1",
		"vue-google-autocomplete": "^1.1.1",
		"vue-i18n": "^9.6.5",
		"vue-ios-pwa-prompt": "^1.0.4",
		"vue-meta": "^2.3.3",
		"vue-router": "^5.0.3",
		"vue-virtual-scroller": "^2.0.0-beta.8",
		"vue3-treeselect": "^0.1.10",
		"vuedraggable": "^4.1.0",
		"vuex": "4.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@juggle/resize-observer": "^3.4.0",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vue/test-utils": "^2.4.1",
		"cross-env": "^7.0.3",
		"eslint": "^10.0.1",
		"eslint-plugin-oxlint": "^1.65.0",
		"eslint-plugin-prettier": "^3.2.0",
		"eslint-plugin-vue": "^10.8.0",
		"eslint-plugin-vuetify": "^2.7.2",
		"globals": "^17.6.0",
		"oxlint": "^1.65.0",
		"prettier": "^3.8.1",
		"sass-embedded": "^1.98.0",
		"vite": "^8.0.13",
		"vite-plugin-commonjs": "^0.10.4",
		"vite-plugin-eslint": "^1.8.1",
		"vite-plugin-vue-devtools": "^8.1.2",
		"vite-plugin-vuetify": "^2.1.3",
		"vuetify": "^4.0.4"
	},
	"engines": {
		"node": ">=10.13.3",
		"yarn": ">=1.0.0"
	},
	"resolutions": {
		"@vue/cli-plugin-unit-jest/jest": "25.1.x",
		"@vue/cli-plugin-unit-jest/babel-jest": "25.1.x"
	}
}
